# ---- Database ----
POSTGRES_USER=researchpilot
POSTGRES_PASSWORD=researchpilot
POSTGRES_DB=researchpilot
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://researchpilot:researchpilot@db:5432/researchpilot

# ---- Auth ----
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- LLM Provider ----
# Single-provider mode. Options: openai | gemini | mistral | groq | mock
# Ignored if LLM_FALLBACK_ORDER is set below.
LLM_PROVIDER=mock

# Multi-provider fallback mode (recommended for production resilience).
# Comma-separated provider names tried in order; each is skipped automatically
# if its API key is missing. "mock" is appended automatically as a guaranteed
# last resort if not already in the list. Leave empty to use LLM_PROVIDER above.
# Example: LLM_FALLBACK_ORDER=gemini,groq,mistral,openai
LLM_FALLBACK_ORDER=

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_EMBEDDING_MODEL=mistral-embed

# Groq has no embeddings API -- it is chat/generation-only in the fallback chain.
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Fixed pgvector column dimension. Every embedding is truncated/padded to this
# length regardless of which provider produced it, so retrieval stays
# consistent even as the fallback chain switches providers. Do not change
# without a new Alembic migration to match.
EMBEDDING_DIM=1536

# ---- Vision Provider ----
# Options: gemini | clip | mock
VISION_PROVIDER=mock
GEMINI_VISION_MODEL=gemini-3.6-flash

# ---- App ----
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=25
STORAGE_DIR=/app/storage

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
